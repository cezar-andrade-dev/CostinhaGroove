# ── SERVIDOR ───────────────────────────────────
PORT=3000

# ── BANCO DE DADOS ──────────────────────────────
# Caminho para o arquivo SQLite (criado automaticamente)
DB_PATH=./data/costinha.db

# ── ARMAZENAMENTO DE ÁUDIO ──────────────────────
# Opção A: arquivos locais (desenvolvimento)
AUDIO_STORAGE=local
AUDIO_LOCAL_PATH=./audio

# Opção B: Cloudflare R2 / AWS S3 (produção)
# AUDIO_STORAGE=s3
# S3_BUCKET=seu-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY=sua_access_key
# S3_SECRET_KEY=sua_secret_key
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── CORS ────────────────────────────────────────
# URL do frontend em produção (Vercel, Netlify, etc.)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
